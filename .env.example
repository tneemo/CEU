# O CEU não carrega este arquivo automaticamente. Exporte os valores no shell
# ou configure-os na sua IDE. Nunca preencha valores reais neste arquivo.

CEU_PORT=4747
CEU_API_PORT=4747
CEU_LOG=
CEU_ROOT=
# Optional absolute data directory. Empty means ./data beside the source.
CEU_DATA_DIR=
CEU_SANDBOX_DISTRO=ceu-sandbox
CEU_SANDBOX_DIR=

# O servidor usa estas chaves somente na primeira inicialização para criar
# provedores locais. Depois, remova-as do ambiente quando não forem necessárias.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
