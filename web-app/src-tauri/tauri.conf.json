{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CEU",
  "version": "0.2.0-rc.2",
  "identifier": "app.ceu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CEU",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0.2"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
